# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
# SQLite: caminho relativo à pasta prisma/ (o docker-compose monta um volume para persistir o arquivo)
DATABASE_URL=file:./dev.db
# JWT — gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173
